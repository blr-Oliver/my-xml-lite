{
  "name": "my-xml-lite",
  "version": "0.1.0",
  "description": "Minimal ArrayBuffer-based UTF-8/UTF-16 DOM XML/HTML parser with weak validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "--test": "'--experimental-vm-modules flag is critical for ESM'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "debug": "node --inspect=9230 dist/debug.js"
  },
  "keywords": [
    "DOM",
    "XML",
    "HTML",
    "parser",
    "utf8",
    "UTF-8",
    "buffer",
    "document",
    "structure"
  ],
  "author": "Vasily Liaskovsky <vasily.liaskovsky@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.28",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2",
    "braces": ">=3.0.3"
  }
}
