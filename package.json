{
  "name": "my-xml-lite",
  "version": "0.1.0",
  "description": "Minimal ArrayBuffer-based UTF-8/UTF-16 DOM XML/HTML parser with weak validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc --project tsconfig.src.json",
    "build-test": "tsc",
    "--test": "--experimental-vm-modules flag is critical for ESM",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "copy-browser-index": "copy test\\index.html dist",
    "start-browser-server": "http-server -c-1 -p8082 ./dist",
    "browsers": "npm run build-test && npm run copy-browser-index && npm run start-browser-server"
  },
  "keywords": [
    "DOM",
    "XML",
    "HTML",
    "parser",
    "utf8",
    "UTF-8",
    "buffer",
    "document",
    "structure"
  ],
  "author": "Vasily Liaskovsky <vasily.liaskovsky@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.28",
    "braces": ">=3.0.3",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
